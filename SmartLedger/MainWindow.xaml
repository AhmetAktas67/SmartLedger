<Window x:Class="SmartLedger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartLedger"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <DataGrid ItemsSource="{Binding Mitglieder}" 
          AutoGenerateColumns="False"
          Margin="10">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Vorname" Binding="{Binding Vorname}" Width="*"/>
            <DataGridTextColumn Header="Nachname" Binding="{Binding Nachname}" Width="*"/>
            <DataGridTextColumn Header="Monatsbeitrag" Binding="{Binding Monatsbeitrag}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>
</Window>
