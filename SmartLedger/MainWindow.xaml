<ui:FluentWindow x:Class="SmartLedger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:SmartLedger.Converters"
        mc:Ignorable="d"
        Title="SmartLedger" Height="700" Width="1350"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <conv:PageVisibilityConverter x:Key="PageVisibilityConverter"/>
        <conv:StatusToTextConverter x:Key="StatusToTextConverter"/>
        <conv:StatusToBackgroundConverter x:Key="StatusToBackgroundConverter"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="ui:Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SmartLedger">
            <ui:TitleBar.Header>
                <TextBlock Text="💶 SmartLedger" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!--  Grid mit Sidebar links + Content rechts -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--  Sidebar -->
            <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#2B2B2B" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16">
                    <ui:Button Content="🏠  Dashboard" Style="{StaticResource NavButtonStyle}"
                               Command="{Binding NavigateCommand}" CommandParameter="0"/>
                    <ui:Button Content="👥  Mitglieder" Style="{StaticResource NavButtonStyle}"
                               Command="{Binding NavigateCommand}" CommandParameter="1"/>
                   
                    <ui:Button Content="📊  Auswertungen" Style="{StaticResource NavButtonStyle}"
                               Command="{Binding NavigateCommand}" CommandParameter="3"/>

                    <ui:Button Content="📑  Kassenauszug" Style="{StaticResource NavButtonStyle}"
                    Command="{Binding NavigateCommand}" CommandParameter="2"/>
                    
                    <ui:Button Content="⚙️  Einstellungen" Style="{StaticResource NavButtonStyle}"
                               Command="{Binding NavigateCommand}" CommandParameter="4"/>
                </StackPanel>
            </Border>

           
            <Grid Grid.Column="1" Margin="20">

                <!-- Seite 0: Dashboard (Platzhalter) -->
                <Grid Visibility="{Binding AktuelleSeite, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=0}">
                    <StackPanel>
                        <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Überblick über Mitglieder und Beitragsstatus." Foreground="Gray" FontSize="13" Margin="0,0,0,24"/>

                        <UniformGrid Columns="4" Rows="1">
                            <ui:Card Margin="0,0,12,0" Padding="20" MinHeight="150">
                                <StackPanel HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="People24" FontSize="34" Foreground="#A0A0A0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding GesamtMitglieder}" FontSize="40" FontWeight="Bold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Gesamtmitglieder" Foreground="#A0A0A0" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Margin="0,0,12,0" Padding="20" MinHeight="150">
                                <StackPanel HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="34" Foreground="#10893E" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding BeitraegeBestaetigt}" FontSize="40" FontWeight="Bold" Foreground="#10893E" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Beiträge bestätigt" Foreground="#A0A0A0" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Margin="0,0,12,0" Padding="20" MinHeight="150">
                                <StackPanel HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Clock24" FontSize="34" Foreground="#D9A400" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding OffeneBeitraege}" FontSize="40" FontWeight="Bold" Foreground="#D9A400" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Offene Beiträge" Foreground="#A0A0A0" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Padding="20" MinHeight="150">
                                <StackPanel HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="34" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding VorschlaegeKI}" FontSize="40" FontWeight="Bold" Foreground="#2563EB" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Vorschläge (KI)" Foreground="#A0A0A0" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ui:Card>
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <!-- Seite 1: Mitglieder -->
                <Grid Visibility="{Binding AktuelleSeite, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                        <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="📄  Kontoauszug importieren"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon ArrowUpload24}"
                           Command="{Binding ImportKontoauszugCommand}"
                           Width="220"/>
                            <TextBlock Text="{Binding ImportStatus}" 
                           VerticalAlignment="Center" 
                           Margin="16,0,0,0"
                           Foreground="#A0A0A0"/>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="1" Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Mitglied erfassen" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="90" Margin="0,0,12,0"
                              ItemsSource="{Binding VerfuegbareJahre}"
                              SelectedItem="{Binding AusgewaehltesJahr}" />
                                            <ui:TextBox Width="160" Margin="0,0,12,0" PlaceholderText="Vorname"
                                Text="{Binding NeuerVorname, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:TextBox Width="160" Margin="0,0,12,0" PlaceholderText="Nachname"
                                Text="{Binding NeuerNachname, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:TextBox Width="110" Margin="0,0,12,0" PlaceholderText="Beitrag €"
                                Text="{Binding NeuerBeitrag, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Content="{Binding ButtonText}" Appearance="Primary"
                               Icon="{ui:SymbolIcon PersonAdd24}"
                               Command="{Binding AddMitgliedCommand}" Width="130" />
                            </StackPanel>
                            <TextBlock Text="{Binding FehlerText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,10,0,0" FontWeight="Medium"/>
                        </StackPanel>
                    </ui:Card>

                    <!--  kombinierte Tabelle, bindet an Beitragsmatrix statt Mitglieder -->
                    <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <DataGrid ItemsSource="{Binding Beitragsmatrix}" AutoGenerateColumns="False"
                  Background="Transparent" BorderThickness="0" RowHeight="42"
                  GridLinesVisibility="Horizontal" Margin="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vorname" Binding="{Binding Vorname}" Width="90"/>
                                <DataGridTextColumn Header="Nachname" Binding="{Binding Nachname}" Width="90"/>
                                <DataGridTextColumn Header="Beitrag (€)" Binding="{Binding Monatsbeitrag}" Width="80"/>
                                <DataGridTextColumn Header="Haushalt" Binding="{Binding Haushaltsgruppe}" Width="80"/>

                                <!--  12 Status-Buttons statt Checkboxen -->
                                <DataGridTemplateColumn Header="Jan" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Januar, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding Januar, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Feb" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Februar, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding Februar, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Mär" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Maerz, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding Maerz, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="3"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Apr" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding April, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding April, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Mai" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Mai, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding Mai, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="5"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Jun" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Juni, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding Juni, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="6"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Jul" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Juli, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding Juli, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="7"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Aug" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding August, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding August, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="8"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Sep" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding September, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding September, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="9"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Okt" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Oktober, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding Oktober, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="10"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Nov" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding November, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding November, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Dez" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Dezember, Converter={StaticResource StatusToTextConverter}}"
                                    Background="{Binding Dezember, Converter={StaticResource StatusToBackgroundConverter}}"
                                    Foreground="White" BorderThickness="0" Margin="2"
                                    Command="{Binding ToggleMonatCommand}" CommandParameter="12"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Bearbeiten" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Content="Bearbeiten" Appearance="Secondary" Icon="{ui:SymbolIcon Edit24}"
                                       Command="{Binding DataContext.EditMitgliedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                       CommandParameter="{Binding Id}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Löschen" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Content="Löschen" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding DataContext.DeleteMitgliedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                       CommandParameter="{Binding Id}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>
                </Grid>



                <!-- Seite 2: Kassenauszug -->
                <Grid Visibility="{Binding AktuelleSeite, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=2}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Kassenauszug" FontSize="26" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Alle importierten Buchungen aus Kontoauszügen, sortierbar." Foreground="Gray" FontSize="13"/>
                    </StackPanel>

                    <!-- <== NEU: Filter-Zeile -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Jahr:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A0A0A0"/>
                        <ComboBox Width="100" Margin="0,0,20,0"
                  ItemsSource="{Binding KassenauszugJahre}"
                  SelectedItem="{Binding KassenauszugJahrFilter}"/>

                        <TextBlock Text="Monat:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A0A0A0"/>
                        <ComboBox Width="130"
                  ItemsSource="{Binding KassenauszugMonate}"
                  SelectedItem="{Binding KassenauszugMonatFilter}"/>
                    </StackPanel>

                    <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <DataGrid ItemsSource="{Binding KassenauszugBuchungen}" AutoGenerateColumns="False"
                  Background="Transparent" BorderThickness="0" RowHeight="42"
                  GridLinesVisibility="Horizontal" Margin="8"
                  CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Datum" Binding="{Binding BuchungsDatum, StringFormat=dd.MM.yyyy}" Width="120"/>
                                <DataGridTextColumn Header="Verwendungszweck" Binding="{Binding Verwendungszweck}" Width="*"/>
                                <DataGridTextColumn Header="Betrag (€)" Binding="{Binding Betrag, StringFormat=F2}" Width="100"/>
                                <DataGridTextColumn Header="Zugeordnet" Binding="{Binding ZugeordneteMitgliederNamen}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>
                </Grid>


                <!-- Seite 3: Auswertungen (Platzhalter) -->
                <Grid Visibility="{Binding AktuelleSeite, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=3}">
                    <TextBlock Text="Auswertungen folgen später" FontSize="20" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Seite 4: Einstellungen (Platzhalter) -->
                <Grid Visibility="{Binding AktuelleSeite, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=4}">
                    <TextBlock Text="Einstellungen folgen später" FontSize="20" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>